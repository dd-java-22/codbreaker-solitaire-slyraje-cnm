<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".controller.GameFragment">

  <Button
    android:id="@+id/new_game"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/new_game"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"/>

  <TextView
    android:id="@+id/status"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:text="@string/status_placeholder"
    app:layout_constraintBottom_toBottomOf="@id/new_game"
    app:layout_constraintEnd_toStartOf="@id/new_game"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="@id/new_game"/>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/guesses"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    app:layout_constraintBottom_toTopOf="@id/current_guess_container"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/new_game"
    tools:listitem="@layout/item_guess"/>

  <LinearLayout
    android:id="@+id/current_guess_container"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="horizontal"
    app:layout_constraintBottom_toTopOf="@id/palette"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <!-- TODO: Square slots will be added here or statically -->

    <TextView
      android:id="@+id/slot_0"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_margin="2dp"
      android:background="@drawable/slot_background"
      android:gravity="center"
      tools:text="R"/>

    <TextView
      android:id="@+id/slot_1"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_margin="2dp"
      android:background="@drawable/slot_background"
      android:gravity="center"
      tools:text="B"/>

    <TextView
      android:id="@+id/slot_2"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_margin="2dp"
      android:background="@drawable/slot_background"
      android:gravity="center"/>

    <TextView
      android:id="@+id/slot_3"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:layout_margin="2dp"
      android:background="@drawable/slot_background"
      android:gravity="center"/>
    <Button
      android:id="@+id/submit"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:enabled="false"
      android:text="@string/submit"
      />

  </LinearLayout>

  <LinearLayout
    android:id="@+id/palette"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <Button
      android:id="@+id/palette_r"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="R"
      android:textColor="@android:color/white"
      android:backgroundTint="@color/red"/>

    <Button
      android:id="@+id/palette_o"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="O"
      android:textColor="@android:color/black"
      android:backgroundTint="@color/orange"/>

    <Button
      android:id="@+id/palette_y"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="Y"
      android:textColor="@android:color/black"
      android:backgroundTint="@color/yellow"/>

    <Button
      android:id="@+id/palette_g"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="G"
      android:textColor="@android:color/black"
      android:backgroundTint="@color/green"/>

    <Button
      android:id="@+id/palette_b"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="B"
      android:textColor="@android:color/white"
      android:backgroundTint="@color/blue"/>

    <Button
      android:id="@+id/palette_i"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="I"
      android:textColor="@android:color/white"
      android:backgroundTint="@color/indigo"/>

    <Button
      android:id="@+id/palette_v"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:text="V"
      android:textColor="@android:color/white"
      android:backgroundTint="@color/violet"/>

  </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
